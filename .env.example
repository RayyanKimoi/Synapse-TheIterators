# SYNAPSE environment configuration — copy to .env and edit.
# Gateway & Server
PORT=8000
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:3000

# LLM Gateway & Local Inference
LITELLM_PROXY_URL=http://localhost:4000
LOCAL_OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=sk-placeholder-demo-key
# REQUIRED for a live run. tool_io nodes make a real Tavily call and fail
# loudly on this placeholder rather than invent search results.
TAVILY_API_KEY=tvly-placeholder-demo-key

# Memory & Semantic Caching
REDIS_HOST=localhost
REDIS_PORT=6379
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88
SEMANTIC_CACHE_TTL_SECONDS=3600

# System Guardrails
MAX_BUDGET_PER_WORKFLOW_USD=0.50
MAX_CONCURRENT_TASKS=8

# false (the default) = real network, real tokens, real database round trips.
# true switches BOTH the model and the tool clients to deterministic stubs; the
# test suite pins it on so it never touches the network.
LLM_OFFLINE_MODE=false
TELEMETRY_TICK_MS=100
